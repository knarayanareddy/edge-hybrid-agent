# Copy to secrets.properties and fill in. secrets.properties is git-ignored.
# Each of these is compiled into BuildConfig and is therefore extractable from the APK.
# Use a revocable key scoped to this app, never a shared production credential.

# ---- Cloud inference (required for the agent to answer anything) ----
# OpenRouter — https://openrouter.ai/keys  (works with most models)
EDGE_CLOUD_API_KEY=
# Google AI Studio — https://aistudio.google.com/apikey (optional alternative)
EDGE_GEMINI_API_KEY=
# Which provider the default build uses. One of: openrouter, google_ai_studio
EDGE_CLOUD_PROVIDER=openrouter
EDGE_CLOUD_MODEL=google/gemini-3.8-flash

# ---- TypeSafe Jev (tool pruning + destructive-action scoring) ----
EDGE_TYPESAFE_API_KEY=

# ---- Optional single-endpoint MCP, for development builds ----
# Prefer managing servers in Tools -> MCP Servers instead.
EDGE_MCP_ENDPOINT=
EDGE_MCP_BEARER_TOKEN=
EDGE_MCP_ENABLED=false
